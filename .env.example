# Which AI service to use: openrouter, openai, or anthropic.
# Leave PROVIDER out and the first key you fill in below is used.
PROVIDER=openrouter

# Fill in the key for the provider you chose (the others can stay blank).
OPENROUTER_API_KEY=your-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MODEL / FALLBACK_MODEL must be models from the provider you chose.
# Leave MODEL blank to use that provider's default:
#   openrouter: minimax/minimax-m3:free   (fallback google/gemma-3-12b-it)
#   openai:     gpt-4o-mini
#   anthropic:  claude-haiku-5-5
# FALLBACK_MODEL is tried when MODEL is unavailable, rate-limited, or out of credits.
# Avoid "reasoning" models here - they burn completion tokens on hidden thinking,
# which can starve short caption outputs.
MODEL=
FALLBACK_MODEL=
CONCURRENCY=4
MIN_IMAGE_SIZE_PX=40
MAX_ALT_TEXT_CHARS=125
