OPENROUTER_API_KEY=your-key-here
MODEL=minimax/minimax-m3:free
# Cheap paid vision model used when MODEL (the free one) is unavailable, rate-limited,
# or 402s for lack of credits. ~$0.05/M input + $0.15/M output tokens - negligible for
# captioning. Avoid "reasoning" models here (e.g. qwen3.7-flash) - they burn completion
# tokens on hidden thinking before the answer, which can starve short caption outputs.
FALLBACK_MODEL=google/gemma-3-12b-it
CONCURRENCY=4
MIN_IMAGE_SIZE_PX=40
MAX_ALT_TEXT_CHARS=125
