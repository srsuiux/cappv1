#!/usr/bin/env bash
# Global launcher for the PPTX alt-text automation. Symlinked onto PATH
# (~/.local/bin/cappv1) so it can be typed from any directory.
#
#   cappv1 / start / init     open the interactive session (slash commands, drag-and-drop)
#   cappv1 start --batch      process every file in input/ in the background (scripts, no prompt)
#   cappv1 doctor                                    check that the environment is set up correctly
#   cappv1 models                                      pick a model (free OpenRouter, or installed in Ollama)
#   cappv1 clean                                         wipe input/, output/, and tracked run state
set -euo pipefail

# Resolve this script's real location, following the symlink at
# ~/.local/bin/cappv1 back to wherever the project actually lives - so
# this works regardless of whose machine or which folder it's cloned into.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
cd "$PROJECT_DIR"

if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
    CYAN=$'\033[36m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; CYAN=""; DIM=""; BOLD=""; RESET=""
fi

usage() {
    cat <<EOF
${BOLD}cappv1${RESET} - PPTX alt-text automation

${BOLD}Usage${RESET}
  cappv1                                   open the interactive session (also: cappv1 start)
  cappv1 init                              open the session straight into setup
  cappv1 start --batch [--resume]          no prompt: process input/ in the background
  cappv1 doctor                            check your setup
  cappv1 models                             pick a model (free OpenRouter, or local Ollama)
  cappv1 clean                               wipe input/, output/, and run state

${BOLD}Examples${RESET}
  cappv1
  cappv1 doctor
  cappv1 models
  cappv1 clean
EOF
}

start() {
    if ! python3 src/doctor.py --quick; then
        echo ""
        echo "${RED}Not ready to run yet${RESET} - see checks above, or run: cappv1 doctor"
        exit 1
    fi

    shopt -s nullglob
    pptx_files=(input/*.pptx)
    if [ ${#pptx_files[@]} -eq 0 ]; then
        echo ""
        echo "${YELLOW}No .pptx files in input/ yet${RESET} - add one, then run: cappv1 start"
        exit 0
    fi

    mkdir -p logs
    # nullglob is on, so this is always a real (possibly empty) array -
    # never pass a bare logs/run-*.log glob straight to `ls`: when it
    # matches nothing, nullglob makes the glob vanish from the command
    # line entirely, silently turning `ls -t logs/run-*.log` into a
    # bare `ls -t` that lists the *project root* instead - which is
    # exactly what happens on a fresh clone's very first run, before
    # any run-*.log file has ever existed.
    before_logs=(logs/run-*.log)
    before_count=${#before_logs[@]}

    nohup ./run.sh "$@" >> logs/cappv1-launcher.log 2>&1 &
    pid=$!
    disown

    echo ""
    echo "${BOLD}${GREEN}✓${RESET} cappv1 started in background (pid $pid)"
    echo ""

    log_file=""
    for _ in $(seq 1 60); do
        current_logs=(logs/run-*.log)
        if [ ${#current_logs[@]} -gt "$before_count" ]; then
            log_file=$(ls -t "${current_logs[@]}" | head -1)
            break
        fi
        sleep 1
    done

    if [ -z "$log_file" ]; then
        echo "${DIM}Still setting up (first run installs dependencies) - check progress with:${RESET}"
        echo "  tail -f \"$PROJECT_DIR/logs\"/run-*.log"
        exit 0
    fi

    echo "${DIM}Live progress - Ctrl+C stops watching, the job keeps running in the background${RESET}"
    echo ""
    tail -n +1 -f "$log_file"
}

clean() {
    shopt -s nullglob
    input_files=(input/*.pptx)
    output_files=(output/*.pptx)
    state_files=(.state/*.json)
    n_in=${#input_files[@]}
    n_out=${#output_files[@]}
    n_state=${#state_files[@]}

    [ "$n_in" -gt 0 ] && rm -f "${input_files[@]}"
    [ "$n_out" -gt 0 ] && rm -f "${output_files[@]}"
    [ "$n_state" -gt 0 ] && rm -f "${state_files[@]}"

    echo "${BOLD}cappv1 clean${RESET}"
    echo ""
    echo "  ${GREEN}✓${RESET} removed $n_in file(s) from input/"
    echo "  ${GREEN}✓${RESET} removed $n_out file(s) from output/"
    echo "  ${GREEN}✓${RESET} cleared $n_state tracked run(s) from .state/"
    echo ""
    echo "Workspace is clean and ready to go - drop files into input/, then run: cappv1 start"
}

doctor() {
    python3 src/doctor.py
}

models() {
    python3 src/models.py
}

session() {
    exec ./run.sh --session "$@"
}

cmd="${1:-}"
case "$cmd" in
    "")
        [ -t 0 ] && [ -t 1 ] && session || usage
        ;;
    init)
        session init
        ;;
    start)
        shift
        # the interactive session needs a real terminal; scripts and --batch get the old behavior
        if [ -t 0 ] && [ -t 1 ] && [[ " $* " != *" --batch "* ]]; then
            session
        else
            args=(); for a in "$@"; do [ "$a" = "--batch" ] || args+=("$a"); done
            start ${args[@]+"${args[@]}"}
        fi
        ;;
    doctor)
        doctor
        ;;
    models)
        models
        ;;
    clean)
        clean
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "${RED}Unknown command:${RESET} $cmd"
        echo ""
        usage
        exit 1
        ;;
esac
