#!/usr/bin/env bash
# Global launcher for the PPTX alt-text automation. Symlinked onto PATH
# (~/.local/bin/cappv1) so it can be typed from any directory.
#
#   cappv1            open cappv1; everything else (/run, /doctor, /models, ...) is typed inside it
#   cappv1 --batch    no prompt, for scripts: process every file in input/ in the background
set -euo pipefail

# Resolve this script's real location, following the symlink at
# ~/.local/bin/cappv1 back to wherever the project actually lives - so
# this works regardless of whose machine or which folder it's cloned into.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
cd "$PROJECT_DIR"

if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'
    CYAN=$'\033[36m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; CYAN=""; DIM=""; BOLD=""; RESET=""
fi

usage() {
    cat <<EOF
${BOLD}cappv1${RESET} - PPTX alt-text automation

${BOLD}Usage${RESET}
  cappv1                    open cappv1 (everything else happens inside it)
  cappv1 --web [--port N] [--no-open]
                            the same thing in your browser, until Ctrl+C
  cappv1 --batch [--resume] [--force]
                            no prompt, for scripts: process input/ in the background
  cappv1 --version

${BOLD}Inside cappv1${RESET}, type / to see the commands:
  /run  /files  /models  /doctor  /status  /open  /clean  /help  /exit
EOF
}

start() {
    if ! python3 src/doctor.py --quick; then
        echo ""
        echo "${RED}Not ready to run yet${RESET} - open cappv1 and type /doctor to see what to fix"
        exit 1
    fi

    shopt -s nullglob
    pptx_files=(input/*.pptx)
    if [ ${#pptx_files[@]} -eq 0 ]; then
        echo ""
        echo "${YELLOW}No .pptx files in input/ yet${RESET} - add one, then run: cappv1 --batch"
        exit 0
    fi

    mkdir -p logs
    # nullglob is on, so this is always a real (possibly empty) array -
    # never pass a bare logs/run-*.log glob straight to `ls`: when it
    # matches nothing, nullglob makes the glob vanish from the command
    # line entirely, silently turning `ls -t logs/run-*.log` into a
    # bare `ls -t` that lists the *project root* instead - which is
    # exactly what happens on a fresh clone's very first run, before
    # any run-*.log file has ever existed.
    before_logs=(logs/run-*.log)
    before_count=${#before_logs[@]}

    nohup ./run.sh "$@" >> logs/cappv1-launcher.log 2>&1 &
    pid=$!
    disown

    echo ""
    echo "${BOLD}${GREEN}✓${RESET} cappv1 started in background (pid $pid)"
    echo ""

    log_file=""
    for _ in $(seq 1 60); do
        current_logs=(logs/run-*.log)
        if [ ${#current_logs[@]} -gt "$before_count" ]; then
            log_file=$(ls -t "${current_logs[@]}" | head -1)
            break
        fi
        sleep 1
    done

    if [ -z "$log_file" ]; then
        echo "${DIM}Still setting up (first run installs dependencies) - check progress with:${RESET}"
        echo "  tail -f \"$PROJECT_DIR/logs\"/run-*.log"
        exit 0
    fi

    echo "${DIM}Live progress - Ctrl+C stops watching, the job keeps running in the background${RESET}"
    echo ""
    tail -n +1 -f "$log_file"
}

session() {
    exec ./run.sh --session "$@"
}

cmd="${1:-}"
case "$cmd" in
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            session
        else
            usage
        fi
        ;;
    --batch)
        shift
        start "$@"
        ;;
    --web)
        shift
        exec ./run.sh --web "$@"
        ;;
    --version|-V)
        python3 src/version.py
        ;;
    -h|--help)
        usage
        ;;
    *)
        echo "${RED}Unknown command:${RESET} $cmd"
        echo ""
        echo "cappv1 has one command. Type ${BOLD}cappv1${RESET} to open it; everything else"
        echo "(/run, /doctor, /models, /clean ...) is typed inside."
        exit 1
        ;;
esac
